# Add these values in Vercel Project Settings -> Environment Variables.
# Never upload a file containing real credentials to GitHub.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-POOLED-POSTGRES-HOST/DATABASE?sslmode=require
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=YOUR-QDRANT-API-KEY

# Semantic embeddings and reranking via HTTPS; no local model downloads.
EMBEDDING_BACKEND=cohere
COHERE_API_KEY=YOUR-COHERE-API-KEY
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_EMBEDDING_DIMENSION=1024
ENABLE_RERANKER=true
RERANKER_BACKEND=cohere
COHERE_RERANKER_MODEL=rerank-v3.5

# For a provider-key-free retrieval smoke test, use hash embeddings and disable reranking.
# EMBEDDING_BACKEND=hash
# ENABLE_RERANKER=false

# Optional generated answers. Leave all three blank for cited source excerpts.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_UPLOAD_MB=4
MAX_CHUNKS=200
COOKIE_SECURE=true
# VERCEL=1 is supplied automatically by Vercel. Set it only for local simulation.
