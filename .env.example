DATABASE_URL=sqlite:///./data/grounded.db
# Production: postgresql+psycopg://grounded:change-me@postgres:5432/grounded
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
EMBEDDING_BACKEND=hash
# Use sentence-transformers for semantic retrieval; hash is only an offline smoke-test mode.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_CACHE_DIR=./data/models/hub
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
ENABLE_RERANKER=false
RERANKER_BACKEND=cross-encoder
# For Vercel use .env.vercel.example and configure hosted services in the dashboard.
# Optional Qwen or another chat-completions-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
COOKIE_SECURE=false
