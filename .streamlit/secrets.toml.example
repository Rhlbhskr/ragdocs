# SAFE TEMPLATE: copy this into Streamlit Cloud -> Advanced settings -> Secrets.
# Replace the placeholder strings there. Do not commit real secrets to GitHub.
APP_MODE = "production"
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
ALLOWED_USERS = []
ALLOW_ALL_AUTHENTICATED = true
AUTH_ISSUER = "https://accounts.google.com"
GEMINI_API_KEY = "PASTE_YOUR_GOOGLE_AI_STUDIO_API_KEY_HERE"
GEMINI_MODEL = "gemini-3.5-flash-lite"
QDRANT_URL = "https://YOUR-CLUSTER.cloud.qdrant.io:6333"
QDRANT_API_KEY = "PASTE_YOUR_QDRANT_DATABASE_API_KEY_HERE"

# Small CPU embedding model; cached across Streamlit reruns and browser sessions.
EMBEDDING_BACKEND = "sentence-transformers"
ENABLE_RERANKER = false
# Enable the small local CrossEncoder only if the deployment has sufficient memory.
# To try the app entirely offline: EMBEDDING_BACKEND = "hash" and omit all keys.
# Also set APP_MODE = "demo" for a temporary, anonymous local demo.

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
